# Copy to .env — the dev script loads it automatically if present.

# Port the API binds to.
PORT=4000

# SQLite file, relative to the server workspace. Created on first boot.
DATABASE_FILE=data/rs.db

# Signing key for session tokens. Must be 32+ characters and is REQUIRED in
# production. Left unset in development, an ephemeral one is generated per boot.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# How long an issued token stays valid, in seconds. Default is 7 days.
JWT_TTL_SECONDS=604800

# Origin allowed to call the API from a browser.
CORS_ORIGIN=http://localhost:5173
